.field-label { font-size: 26rpx; color: var(--text-soft); margin: 28rpx 0 14rpx; }
.field-label:first-child { margin-top: 4rpx; }

/* 封面：大块可点区域 */
.cover { display: flex; align-items: center; gap: 24rpx; }
.cover-main {
  width: 200rpx; height: 200rpx; border-radius: 24rpx; flex: 0 0 auto; overflow: hidden;
  background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
  display: flex; align-items: center; justify-content: center; position: relative;
  box-shadow: 0 8rpx 24rpx var(--shadow);
}
.cover-main:active { transform: scale(.97); }
.cover-img { width: 100%; height: 100%; }
.cover-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; }
.cover-ic { font-size: 60rpx; }
.cover-tx { font-size: 22rpx; color: var(--text-soft); }
.cover-remove {
  font-size: 24rpx; color: var(--danger); background: var(--surface-2);
  border: 1rpx solid var(--border); padding: 14rpx 24rpx; border-radius: 14rpx;
}
.cover-remove:active { opacity: .7; }

/* emoji 网格 */
.emoji-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.emoji-opt {
  width: 84rpx; height: 84rpx; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center; font-size: 44rpx;
  background: var(--surface-2); border: 2rpx solid var(--border);
}
.emoji-opt.on { border-color: var(--primary); background: var(--primary-soft); box-shadow: 0 6rpx 16rpx -4rpx var(--shadow); }
.emoji-opt.custom { width: 130rpx; padding: 0 12rpx; }
.emoji-input { width: 100%; text-align: center; font-size: 26rpx; color: var(--text); }

/* 两列布局 */
.row2 { display: flex; gap: 20rpx; }
.row2 .col { flex: 1; min-width: 0; }

.input {
  background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx;
  padding: 22rpx 24rpx; font-size: 30rpx; width: 100%; box-sizing: border-box;
}
.input.area { height: 150rpx; }
.picker {
  background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx;
  padding: 22rpx 24rpx; font-size: 30rpx; color: var(--text);
}

.mode-group { display: flex; flex-direction: column; }
.mode-opt {
  display: flex; align-items: center; padding: 18rpx 20rpx; margin-bottom: 14rpx;
  background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx;
  font-size: 28rpx;
}
.mode-opt.on { border-color: var(--primary); background: var(--primary-soft); }

.tip { font-size: 22rpx; padding: 0 30rpx; line-height: 1.7; margin: 10rpx 0 30rpx; }

.save { margin: 10rpx 24rpx; }
.cancel { margin: 16rpx 24rpx 40rpx; }
