.field-label { font-size: 26rpx; color: var(--text-soft); margin: 30rpx 0 14rpx; font-weight: 600; }
.field-label:first-child { margin-top: 4rpx; }

/* 封面 + emoji 并排 */
.cover-row { display: flex; align-items: stretch; gap: 22rpx; }
.cover-main {
  width: 200rpx; height: 200rpx; border-radius: 24rpx; flex: 0 0 auto; overflow: hidden;
  background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
  display: flex; align-items: center; justify-content: center; position: relative;
  box-shadow: 0 8rpx 24rpx var(--shadow);
}
.cover-main:active { transform: scale(.97); }
.cover-img { width: 100%; height: 100%; }
.cover-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; padding: 0 10rpx; text-align: center; }
.cover-ic { font-size: 60rpx; }
.cover-tx { font-size: 22rpx; color: var(--text-soft); line-height: 1.4; }

.emoji-side { flex: 1; min-width: 0; display: flex; align-items: center; }
.emoji-mini { display: flex; flex-wrap: wrap; gap: 14rpx; }
.emini {
  width: 78rpx; height: 78rpx; border-radius: 18rpx; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
  background: var(--surface-2); border: 2rpx solid var(--border);
}
.emini.on { border-color: var(--primary); background: var(--primary-soft); box-shadow: 0 6rpx 16rpx -4rpx var(--shadow); }
.emini.custom { width: 92rpx; padding: 0 8rpx; }
.emini-in { width: 100%; text-align: center; font-size: 30rpx; color: var(--text); }

.cover-remove {
  align-self: flex-start; margin-top: 16rpx;
  font-size: 24rpx; color: var(--danger); background: var(--surface-2);
  border: 1rpx solid var(--border); padding: 14rpx 24rpx; border-radius: 14rpx;
}
.cover-remove:active { opacity: .7; }

/* 两列布局 */
.row2 { display: flex; gap: 20rpx; }
.row2 .col { flex: 1; min-width: 0; }

.input {
  background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx;
  padding: 0 24rpx; height: 86rpx; line-height: 86rpx;
  font-size: 30rpx; width: 100%; box-sizing: border-box; color: var(--text);
}
.input.area { height: 160rpx; line-height: 1.5; padding: 20rpx 24rpx; width: 100%; }
.picker {
  background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx;
  padding: 22rpx 24rpx; font-size: 30rpx; color: var(--text); box-sizing: border-box;
}

/* 计费方式：分段控件 */
.seg { display: flex; background: var(--surface-2); border: 1rpx solid var(--border); border-radius: 16rpx; padding: 6rpx; gap: 6rpx; }
.seg-opt {
  flex: 1; text-align: center; font-size: 28rpx; font-weight: 600; color: var(--text-soft);
  padding: 18rpx 0; border-radius: 12rpx; transition: .2s;
}
.seg-opt.on { background: var(--primary); color: #fff; box-shadow: 0 6rpx 16rpx -6rpx var(--shadow); }
.seg-hint { font-size: 22rpx; color: var(--text-soft); margin-top: 12rpx; line-height: 1.5; }

.tip { font-size: 22rpx; padding: 0 30rpx; line-height: 1.7; margin: 10rpx 0 30rpx; }

.save { margin: 10rpx 24rpx; }
.cancel { margin: 16rpx 24rpx 60rpx; }
