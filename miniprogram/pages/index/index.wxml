<view class="page theme-{{theme}}">

  <!-- 顶部统计 -->
  <view class="card hero">
    <view class="row hero-top">
      <view class="hero-block">
        <view class="hero-num">{{stats.total}}</view>
        <view class="hero-label">总投入</view>
      </view>
      <view class="hero-block">
        <view class="hero-num">{{stats.perDay}}</view>
        <view class="hero-label">每日陪伴成本</view>
      </view>
      <view class="hero-block">
        <view class="hero-num">{{stats.count}}</view>
        <view class="hero-label">在册物品</view>
      </view>
    </view>
    <view wx:if="{{stats.neg > 0}}" class="hero-tip warn">
      🌫️ 有 {{stats.neg}} 件物品在吃灰，是时候断舍离了
    </view>
    <view wx:else class="hero-tip">✨ 物尽其用，轻盈生活</view>
  </view>

  <!-- 标签切换 -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab {{tab === item.key ? 'on' : ''}}"
      data-key="{{item.key}}" bindtap="onTab">{{item.label}}</view>
  </view>

  <!-- 筛选 + 排序 -->
  <view class="filterbar">
    <scroll-view scroll-x class="chips">
      <view wx:for="{{cats}}" wx:key="*this"
        class="chip {{filterCat === item ? 'on' : ''}}"
        data-cat="{{item}}" bindtap="onFilter">{{item}}</view>
    </scroll-view>
    <picker mode="selector" range="{{['最近添加','成本降序','成本升序','最久未用']}}" bindchange="onSort">
      <view class="sort-btn">⇅ 排序</view>
    </picker>
  </view>

  <!-- 物品列表 -->
  <view wx:if="{{items.length === 0}}" class="empty">
    <view style="font-size:64rpx">🪶</view>
    <view style="margin-top:20rpx">这里还空空如也</view>
    <view style="margin-top:10rpx">点击右下角 + ，记录第一件陪伴你的好物</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="card item"
    data-id="{{item.id}}" bindtap="onEdit" bindlongpress="onLongPress">
    <view class="item-thumb">{{item._thumb}}</view>
    <view class="item-main">
      <view class="row item-head">
        <text class="item-name">{{item.name}}</text>
        <text wx:if="{{item._archived}}" class="pill">已告别</text>
      </view>
      <view class="item-meta muted">
        {{item.category}} · 陪伴 {{item._days}} 天
        <text wx:if="{{item._idleText}}"> · {{item._idleText}}</text>
      </view>
      <view class="row item-tags">
        <text class="pill" wx:for="{{item._statuses}}" wx:for-item="s" wx:key="id"
          style="background:{{s.color}}22;color:{{s.color}}">{{s.emoji}} {{s.name}}</text>
      </view>
    </view>
    <view class="item-cost">
      <view class="cost-num">{{item._perUse}}</view>
      <view class="cost-label muted">每次成本</view>
    </view>
  </view>

  <!-- 悬浮新增 -->
  <view class="fab" bindtap="onAdd">＋</view>

</view>
