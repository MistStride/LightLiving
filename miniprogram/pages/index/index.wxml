<view class="page theme-{{theme}}">

  <!-- 渐变页头 -->
  <view class="header">
    <view class="brand">
      <view class="brand-dot"></view>
      <view class="brand-tx">物尽其轻<text class="brand-sub">LIGHT LIVING</text></view>
    </view>
    <view class="gear" bindtap="goSettings">⚙</view>

    <view class="hero-cost">
      <view class="label">总投入</view>
      <view class="amount">{{stats.total}}</view>
    </view>
  </view>

  <!-- 数据面板（磨砂卡片） -->
  <view class="panel">
    <view class="lightness">
      <view class="ring" style="--p:{{stats.lightness}}">
        <view class="ring-b">{{stats.lightness}}<text class="ring-p">%</text></view>
      </view>
      <view class="l-txt">
        <view class="l-title">轻盈度</view>
        <view class="l-sub">{{stats.neg > 0 ? '有 ' + stats.neg + ' 件在吃灰，是时候断舍离了' : '物尽其用，轻盈生活'}}</view>
      </view>
    </view>
    <view class="hero-stats">
      <view class="hcol"><view class="hb">{{stats.perDay}}</view><view class="hs">每日陪伴成本</view></view>
      <view class="hcol"><view class="hb">{{stats.count}}</view><view class="hs">在册好物</view></view>
      <view class="hcol"><view class="hb neg">{{stats.neg}}</view><view class="hs">在吃灰</view></view>
    </view>
  </view>

  <!-- 标签切换 -->
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab {{tab === item.key ? 'on' : ''}}"
      data-key="{{item.key}}" bindtap="onTab">{{item.label}}</view>
  </view>

  <!-- 搜索 + 分类筛选 + 排序 -->
  <view class="filterbar">
    <view class="search">
      <text class="search-ic">🔍</text>
      <input class="search-in" placeholder="搜索名称或备注" value="{{search}}" bindinput="onSearch" confirm-type="search" />
      <text wx:if="{{search}}" class="search-clr" bindtap="onClearSearch">✕</text>
    </view>
  </view>
  <view class="filterbar">
    <scroll-view scroll-x class="chips" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{cats}}" wx:key="*this"
        class="chip {{filterCat === item ? 'on' : ''}}"
        data-cat="{{item}}" bindtap="onFilter">{{item}}</view>
    </scroll-view>
    <picker mode="selector" range="{{['最近添加','成本降序','成本升序','最久未用']}}" bindchange="onSort">
      <view class="sort-btn">⇅ 排序</view>
    </picker>
  </view>

  <!-- 物品列表 -->
  <view wx:if="{{items.length === 0}}" class="empty">
    <view class="em">🪶</view>
    <view class="et">{{emptyTitle}}</view>
    <view class="es">{{emptySub}}</view>
    <view wx:if="{{tab !== 'gone'}}" class="empty-btn" bindtap="loadSamples">载入示例好物</view>
  </view>

  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="card item"
      data-id="{{item.id}}" bindtap="onEdit" bindlongpress="onLongPress">
      <image wx:if="{{item._img}}" class="thumb" src="{{item._img}}" mode="aspectFill" />
      <view wx:else class="thumb">{{item._thumb}}</view>
      <view class="body">
        <view class="name">{{item.name}}<text class="cat-pill">{{item.category}}</text></view>
        <view class="meta muted">
          <block wx:if="{{item.mode === 'time'}}">陪伴 <text class="b">{{item._days}}</text> 天 · 原价 <text class="b">{{item._priceText}}</text></block>
          <block wx:else>打卡 <text class="b">{{item.useCount}}</text> 次 · 原价 <text class="b">{{item._priceText}}</text> · {{item._idleText}}</block>
        </view>
        <view class="tags">
          <text wx:for="{{item._statuses}}" wx:for-item="s" wx:key="id" class="status-pill" style="color:{{s.color}};background:{{s.color}}22">{{s.emoji}} {{s.name}}</text>
        </view>
        <view wx:if="{{item._archived}}" class="archived-tag">💜 圆满告别 · {{item._archiveReason}}</view>
        <view wx:if="{{item._farewellNote}}" class="note">💬 {{item._farewellNote}}</view>
        <view wx:elif="{{item._note}}" class="note">💬 {{item._note}}</view>
      </view>
      <view class="cost">
        <view class="cost-num">{{item._perUse}}</view>
        <view class="cost-label muted">{{item.mode === 'time' ? '每日成本' : '每次成本'}}</view>
      </view>
    </view>
  </view>

  <!-- 悬浮新增 -->
  <view class="fab" bindtap="onAdd">＋</view>

  <!-- 告别 sheet（对齐网页：个性化告别语 + 方式 + 必填评语） -->
  <view wx:if="{{showFarewell}}" class="fs-mask" bindtap="closeFarewell">
    <view class="fs-sheet" catchtap="noop">
      <view class="fs-handle"></view>
      <view class="fs-title">断·舍·离</view>
      <view class="fs-sub">放手，轻盈地生活。</view>
      <view class="fs-card">
        <view class="fs-heart">💜</view>
        <view class="fs-msg">{{farewellMsg}}</view>
      </view>
      <view class="fs-label">告别方式</view>
      <view class="fs-reasons">
        <view wx:for="{{farewellReasons}}" wx:key="*this"
          class="fs-reason {{farewellReason === item ? 'on' : ''}}" data-r="{{item}}" bindtap="pickReason">{{item}}</view>
      </view>
      <view class="fs-label">给它的告别评语 <text class="fs-req">*</text></view>
      <textarea class="fs-note" value="{{farewellNote}}" bindinput="onFarewellNote"
        placeholder="写句心里话，比如：谢谢你陪我走过那段日子，希望下一位主人也喜欢你。" maxlength="140" />
      <view class="fs-actions">
        <view class="btn-ghost fs-cancel" bindtap="closeFarewell">再想想</view>
        <view class="btn-primary fs-confirm" bindtap="confirmFarewell">圆满告别</view>
      </view>
    </view>
  </view>

  <!-- 庆祝撒花 -->
  <view wx:if="{{celebrate}}" class="celebrate">
    <view wx:for="{{confetti}}" wx:key="id" class="confetti" style="{{item.style}}">{{item.e}}</view>
    <view class="celebrate-emoji">🎉</view>
  </view>

</view>
