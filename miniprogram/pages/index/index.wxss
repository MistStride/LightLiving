/* ===== 陪伴册首页：对齐原版视觉（渐变 / 磨砂 / 环 / 卡片） ===== */

/* 渐变页头（用主题专属 hero-grad，夜间为深色，不再发绿） */
.header {
  background: var(--hero-grad);
  padding: 0 40rpx 60rpx;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  position: relative;
}
.status-spacer { width: 100%; }
.brand { display: flex; align-items: center; gap: 14rpx; }
.brand-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #fff; box-shadow: 0 0 0 8rpx rgba(255,255,255,.25); }
.brand-tx { font-weight: 700; font-size: 34rpx; color: #fff; display: flex; align-items: baseline; gap: 12rpx; }
.brand-sub { font-weight: 500; font-size: 20rpx; color: rgba(255,255,255,.7); letter-spacing: 2rpx; }
.h-top { display: flex; align-items: center; justify-content: space-between; }

.hero-cost { margin-top: 36rpx; }
.hero-cost .label { font-size: 24rpx; color: rgba(255,255,255,.85); font-weight: 500; }
.hero-cost .amount { font-size: 76rpx; font-weight: 800; color: #fff; line-height: 1.05; margin-top: 4rpx; letter-spacing: -2rpx; }

/* 数据面板（磨砂卡片，覆盖页头底部） */
.panel {
  margin: -40rpx 32rpx 0; background: var(--surface); border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx var(--shadow); padding: 28rpx;
  position: relative; z-index: 2;
}
.lightness { display: flex; align-items: center; gap: 28rpx; }
.ring {
  --p: 0; width: 116rpx; height: 116rpx; border-radius: 50%; flex: 0 0 auto; position: relative;
  background: conic-gradient(var(--primary) calc(var(--p) * 1%), var(--primary-soft) 0);
  display: flex; align-items: center; justify-content: center;
}
.ring::before { content: ""; position: absolute; width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--surface); }
.ring-b { position: relative; font-size: 32rpx; font-weight: 800; color: var(--primary); }
.ring-p { font-size: 20rpx; }
.l-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.l-sub { font-size: 22rpx; color: var(--text-soft); margin-top: 8rpx; line-height: 1.5; }

/* 统计三栏（主题色文字，在吃灰恒为警示色） */
.hero-stats { display: flex; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }
.hcol { flex: 1; text-align: center; }
.hcol .hb { display: block; font-size: 38rpx; font-weight: 800; color: var(--text); line-height: 1.1; }
.hcol .hb.neg { color: var(--danger); }
.hcol .hs { font-size: 21rpx; color: var(--text-soft); font-weight: 500; margin-top: 6rpx; }

/* 标签切换（渐变选中） */
.tabs { display: flex; background: var(--surface); margin: 28rpx 32rpx 0; border-radius: 24rpx; padding: 8rpx; box-shadow: 0 6rpx 24rpx var(--shadow); }
.tabs .tab { flex: 1; text-align: center; font-size: 26rpx; font-weight: 600; color: var(--text-soft); padding: 20rpx 0; border-radius: 18rpx; transition: .25s; }
.tabs .tab.on { background: linear-gradient(135deg, var(--primary), var(--secondary-soft)); color: #fff; box-shadow: 0 8rpx 20rpx -6rpx var(--shadow); }

/* 筛选 + 排序 */
.filterbar { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 32rpx 8rpx; }
.search {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
  background: var(--surface); border: 1rpx solid var(--border);
  border-radius: 999rpx; padding: 16rpx 28rpx; box-shadow: 0 6rpx 24rpx var(--shadow);
}
.search-ic { font-size: 28rpx; opacity: .7; }
.search-in { flex: 1; font-size: 28rpx; }
.search-clr { font-size: 26rpx; color: var(--text-soft); padding: 0 6rpx; }
.chips { flex: 1; white-space: nowrap; }
.chip {
  display: inline-block; border: 1rpx solid var(--border); background: var(--surface);
  color: var(--text-soft); font-size: 24rpx; font-weight: 600; padding: 14rpx 26rpx;
  border-radius: 999rpx; margin-right: 14rpx;
}
.chip.on { background: var(--primary-soft); border-color: var(--primary-soft); color: var(--primary); }

/* 排序栏（对齐网页：左侧数量 + 右侧排序选项） */
.sortbar { display: flex; align-items: center; gap: 18rpx; padding: 4rpx 32rpx 12rpx; }
.sort-count { font-size: 24rpx; color: var(--text-soft); font-weight: 600; white-space: nowrap; }
.sort-chips { flex: 1; white-space: nowrap; }
.sort-chip {
  display: inline-block; border: 1rpx solid var(--border); background: var(--surface);
  color: var(--text-soft); font-size: 23rpx; font-weight: 600; padding: 12rpx 22rpx;
  border-radius: 999rpx; margin-right: 12rpx;
}
.sort-chip.on { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); }
.sort-chip.on::after { content: ' ✓'; opacity: .8; }

/* 列表与卡片 */
.list { padding: 12rpx 32rpx 20rpx; display: flex; flex-direction: column; gap: 24rpx; }
.card.item {
  background: var(--surface); border-radius: 28rpx; box-shadow: 0 6rpx 24rpx var(--shadow);
  padding: 26rpx; display: flex; gap: 24rpx; align-items: flex-start;
  animation: fadeUp .42s cubic-bezier(.22,1,.36,1) both;
}
@keyframes fadeUp { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: none; } }
.thumb {
  width: 140rpx; height: 140rpx; border-radius: 24rpx; flex: 0 0 auto; object-fit: cover;
  background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
  display: flex; align-items: center; justify-content: center; font-size: 60rpx;
}
.body { flex: 1; min-width: 0; }
.name { font-size: 32rpx; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 14rpx; }
.cat-pill { font-size: 18rpx; font-weight: 700; color: var(--primary); background: var(--primary-soft); padding: 4rpx 14rpx; border-radius: 999rpx; }
.meta { font-size: 24rpx; color: var(--text-soft); margin-top: 12rpx; line-height: 1.4; }
.meta .b { color: var(--text); font-weight: 700; }
.tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.status-pill { font-size: 20rpx; font-weight: 700; padding: 8rpx 16rpx; border-radius: 999rpx; }
.note { margin-top: 14rpx; font-size: 23rpx; color: var(--text-soft); background: var(--surface-2); padding: 12rpx 18rpx; border-radius: 14rpx; line-height: 1.5; }
.cost { text-align: right; flex: 0 0 auto; align-self: center; }
.cost-num { font-size: 36rpx; font-weight: 800; color: var(--primary); }
.cost-label { font-size: 20rpx; margin-top: 4rpx; }

/* 空态 */
.empty { text-align: center; color: var(--text-soft); padding: 120rpx 40rpx; }
.empty .em { font-size: 96rpx; }
.empty .et { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; color: var(--text); }
.empty .es { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }

/* 悬浮新增（渐变） */
.fab {
  position: fixed; left: 50%; transform: translateX(-50%);
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--secondary-soft));
  color: #fff; font-size: 60rpx; font-weight: 300;
  box-shadow: 0 20rpx 44rpx -8rpx var(--shadow); z-index: 30;
  display: flex; align-items: center; justify-content: center;
}
.fab:active { transform: translateX(-50%) scale(.92); }

/* 空态载入示例按钮 */
.empty-btn {
  margin: 36rpx auto 0; display: inline-block; padding: 18rpx 44rpx;
  background: var(--primary); color: #fff; border-radius: 999rpx; font-size: 26rpx; font-weight: 600;
  box-shadow: 0 12rpx 28rpx -8rpx var(--shadow);
}
.empty-btn:active { transform: scale(.96); }

/* 归档卡片：告别方式 + 评语 */
.archived-tag {
  margin-top: 16rpx; display: inline-block; font-size: 21rpx; font-weight: 700;
  color: var(--primary); background: var(--primary-soft); padding: 8rpx 18rpx; border-radius: 999rpx;
}

/* ===== 告别 sheet ===== */
.fs-mask {
  position: fixed; inset: 0; background: rgba(15, 22, 20, 0.5);
  display: flex; align-items: flex-end; z-index: 60; animation: fadeIn .2s ease both;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.fs-sheet {
  width: 100%; background: var(--surface); border-top-left-radius: 36rpx; border-top-right-radius: 36rpx;
  padding: 18rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box;
  animation: slideUp .28s cubic-bezier(.22,1,.36,1) both;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: none; } }
.fs-handle { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: var(--border); margin: 8rpx auto 24rpx; }
.fs-title { font-size: 38rpx; font-weight: 800; color: var(--text); text-align: center; }
.fs-sub { font-size: 24rpx; color: var(--text-soft); text-align: center; margin-top: 8rpx; }
.fs-card {
  margin: 28rpx 0; background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
  border-radius: 24rpx; padding: 32rpx; text-align: center;
}
.fs-heart { font-size: 56rpx; }
.fs-msg { font-size: 27rpx; line-height: 1.7; color: var(--text); font-weight: 600; margin-top: 12rpx; white-space: pre-line; }
.fs-label { font-size: 26rpx; font-weight: 700; color: var(--text); margin: 24rpx 0 14rpx; }
.fs-req { color: var(--danger); }
.fs-reasons { display: flex; gap: 16rpx; }
.fs-reason {
  flex: 1; text-align: center; font-size: 26rpx; padding: 22rpx 0; border-radius: 16rpx;
  background: var(--surface-2); border: 2rpx solid var(--border); color: var(--text-soft); font-weight: 600;
}
.fs-reason.on { background: var(--primary-soft); border-color: var(--primary); color: var(--primary); }
.fs-note {
  width: 100%; box-sizing: border-box; min-height: 150rpx; background: var(--surface-2);
  border: 1rpx solid var(--border); border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.6;
}
.fs-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.fs-cancel { flex: 0 0 36%; }
.fs-confirm { flex: 1; }

/* ===== 庆祝撒花 ===== */
.celebrate { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 90; }
.confetti {
  position: absolute; top: -60rpx; font-size: 44rpx;
  animation-name: confettiFall; animation-timing-function: linear; animation-fill-mode: forwards;
}
@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0); opacity: 1; }
  100% { transform: translateY(125vh) rotate(540deg); opacity: 0; }
}
.celebrate-emoji {
  position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%);
  font-size: 140rpx; animation: pop .6s cubic-bezier(.22,1.4,.36,1) both;
}
@keyframes pop { 0% { transform: translate(-50%,-50%) scale(.2); opacity: 0; } 60% { transform: translate(-50%,-50%) scale(1.15); opacity: 1; } 100% { transform: translate(-50%,-50%) scale(1); opacity: 1; } }
