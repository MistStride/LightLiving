.hero { margin-top: 24rpx; }
.hero-top { justify-content: space-between; }
.hero-block { flex: 1; text-align: center; }
.hero-num { font-size: 38rpx; font-weight: 700; color: var(--primary); }
.hero-label { font-size: 22rpx; color: var(--text-soft); margin-top: 6rpx; }
.hero-tip { margin-top: 20rpx; font-size: 24rpx; text-align: center; color: var(--text-soft); }
.hero-tip.warn { color: var(--warn); }

.tabs { display: flex; padding: 18rpx 24rpx 0; }
.tab {
  flex: 1; text-align: center; font-size: 28rpx; padding: 16rpx 0;
  color: var(--text-soft); border-bottom: 4rpx solid transparent;
}
.tab.on { color: var(--primary); font-weight: 600; border-bottom-color: var(--primary); }

.filterbar { display: flex; align-items: center; padding: 12rpx 24rpx; }
.chips { flex: 1; white-space: nowrap; }
.chip {
  display: inline-block; padding: 10rpx 24rpx; margin-right: 14rpx;
  border-radius: 999rpx; font-size: 24rpx; background: var(--surface);
  color: var(--text-soft); border: 1rpx solid var(--border);
}
.chip.on { background: var(--primary-soft); color: var(--primary); border-color: transparent; }
.sort-btn {
  font-size: 24rpx; color: var(--text-soft); padding: 10rpx 20rpx;
  background: var(--surface); border-radius: 999rpx; border: 1rpx solid var(--border);
}

.item { display: flex; align-items: center; }
.item-thumb {
  width: 96rpx; height: 96rpx; border-radius: 22rpx; flex-shrink: 0;
  background: var(--primary-soft); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; margin-right: 22rpx;
}
.item-main { flex: 1; min-width: 0; }
.item-head { justify-content: space-between; }
.item-name { font-size: 30rpx; font-weight: 600; }
.item-meta { font-size: 22rpx; margin-top: 6rpx; }
.item-tags { margin-top: 10rpx; flex-wrap: wrap; }
.item-cost { text-align: right; flex-shrink: 0; margin-left: 16rpx; }
.cost-num { font-size: 30rpx; font-weight: 700; color: var(--text); }
.cost-label { font-size: 20rpx; }

.fab {
  position: fixed; right: 44rpx; bottom: 60rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: var(--primary); color: #fff; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 30rpx var(--shadow); z-index: 50;
}
