<view class="page theme-{{theme}}">

  <view class="card profile">
    <view class="profile-ico">🪶</view>
    <view>
      <view class="profile-name">物尽其轻</view>
      <view class="profile-sub muted">极简物品陪伴记录 · v{{ver}}</view>
    </view>
  </view>

  <view class="card">
    <view class="field-label">主题配色</view>
    <view class="theme-row">
      <view wx:for="{{themes}}" wx:key="key" class="theme-chip {{theme === item.key ? 'on' : ''}}"
        data-key="{{item.key}}" bindtap="pickTheme">
        <view class="theme-dot" style="background:{{item.primary}}"></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-row" bindtap="goGuide"><text class="mr-ico">📖</text><text class="mr-tx">使用指南</text><text class="mr-ar">›</text></view>
    <view class="menu-row" bindtap="goRules"><text class="mr-ico">🏷️</text><text class="mr-tx">状态与关系规则</text><text class="mr-ar">›</text></view>
    <view class="menu-row" bindtap="goCats"><text class="mr-ico">🗂️</text><text class="mr-tx">物品分类管理</text><text class="mr-ar">›</text></view>
    <view class="menu-row" bindtap="goBackup"><text class="mr-ico">💾</text><text class="mr-tx">数据备份与恢复</text><text class="mr-ar">›</text></view>
    <view class="menu-row" bindtap="about"><text class="mr-ico">ℹ️</text><text class="mr-tx">关于</text><text class="mr-ar">›</text></view>
  </view>

  <view class="foot muted">数据仅存于本机，建议定期备份。放手，轻盈地生活。</view>

</view>
