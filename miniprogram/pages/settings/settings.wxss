.profile { display: flex; align-items: center; margin-top: 24rpx; }
.profile-ico { width: 96rpx; height: 96rpx; border-radius: 24rpx; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 52rpx; margin-right: 24rpx; }
.profile-info { display: flex; flex-direction: column; justify-content: center; }
.profile-name { font-size: 34rpx; font-weight: 700; color: var(--text); }
.profile-slogan { font-size: 24rpx; margin-top: 8rpx; color: var(--primary); font-weight: 600; }

.field-label { font-size: 26rpx; color: var(--text-soft); margin: 6rpx 0 18rpx; }
.theme-row { display: flex; gap: 16rpx; }
.theme-chip {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx;
  padding: 18rpx 0; border-radius: 16rpx; border: 2rpx solid var(--border);
  background: var(--surface-2); font-size: 26rpx; color: var(--text-soft); font-weight: 600;
}
.theme-chip:last-child { margin-right: 0; }
.theme-chip.on { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); }
.theme-dot { width: 26rpx; height: 26rpx; border-radius: 50%; flex: 0 0 auto; }

.menu { padding: 6rpx 0; }
.menu-row { display: flex; align-items: center; padding: 30rpx 28rpx; border-bottom: 1rpx solid var(--border); }
.menu-row:last-child { border-bottom: none; }
.mr-ico { font-size: 36rpx; margin-right: 20rpx; }
.mr-tx { flex: 1; font-size: 30rpx; }
.mr-ar { color: var(--text-soft); font-size: 36rpx; }

.foot { text-align: center; font-size: 22rpx; padding: 40rpx 40rpx; line-height: 1.7; }

/* 数据守护卡片 */
.guard { background: var(--primary-soft); }
.guard-head { display: flex; align-items: center; }
.guard-ico { font-size: 40rpx; width: 64rpx; text-align: center; margin-right: 18rpx; }
.guard-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.guard-sub { font-size: 23rpx; color: var(--text-soft); margin-top: 6rpx; }
.guard-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--border); }
.guard-info { display: flex; flex-direction: column; }
.guard-label { font-size: 22rpx; color: var(--text-soft); }
.guard-val { font-size: 28rpx; font-weight: 600; color: var(--text); margin-top: 6rpx; }
.guard-btn { font-size: 26rpx; font-weight: 600; color: #fff; background: var(--primary); padding: 14rpx 36rpx; border-radius: 999rpx; }
.guard-btn:active { opacity: .85; }
