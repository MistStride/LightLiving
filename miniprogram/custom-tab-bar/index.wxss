/* 主题变量（组件样式隔离，需自带；与 app.wxss 保持一致） */
.theme-mint {
  --surface: #ffffff;
  --surface-2: #f1faf5;
  --secondary-soft: #cdeede;
  --primary: #3fae8e;
  --primary-soft: #e2f5ee;
  --text-soft: #5b7a6f;
  --shadow: rgba(63, 174, 142, 0.20);
}
.theme-purple {
  --surface: #ffffff;
  --surface-2: #f5f0ff;
  --secondary-soft: #e3dbff;
  --primary: #8b5cf6;
  --primary-soft: #ede9fe;
  --text-soft: #6b6390;
  --shadow: rgba(139, 92, 246, 0.18);
}
.theme-night {
  --surface: #1f2624;
  --surface-2: #232b29;
  --secondary-soft: #2a3a44;
  --primary: #6fd3b5;
  --primary-soft: #243a33;
  --text-soft: #9fb3ac;
  --shadow: rgba(0, 0, 0, 0.45);
}

.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; z-index: 60;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, var(--surface) 0%, var(--secondary-soft) 100%);
  box-shadow: 0 -10rpx 30rpx var(--shadow);
}
.tb-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 14rpx 0 12rpx; gap: 4rpx; position: relative;
  color: var(--text-soft);
}
.tb-item.on { color: var(--primary); }
.tb-ico { font-size: 42rpx; line-height: 1; transition: transform .2s; }
.tb-item.on .tb-ico { transform: translateY(-2rpx) scale(1.06); }
.tb-tx { font-size: 22rpx; font-weight: 600; }
.tb-item.on::after {
  content: ""; position: absolute; top: 8rpx; width: 56rpx; height: 56rpx;
  border-radius: 50%; background: var(--primary-soft); z-index: -1;
}
