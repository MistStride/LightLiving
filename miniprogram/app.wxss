/* ===== 物尽其轻 · 全局样式与三套主题 ===== */
/* 主题通过页面根 view 的 class 切换：theme-mint / theme-purple / theme-night */

.theme-mint {
  --bg: #e6f6ee;
  --bg-grad: linear-gradient(165deg, #C9ECDA 0%, #DDF3EC 100%);
  --surface: #ffffff;
  --surface-2: #f1faf5;
  --primary: #3fae8e;
  --primary-soft: #e2f5ee;
  --secondary-soft: #cdeede;
  --text: #1f332e;
  --text-soft: #5b7a6f;
  --border: #d8efe5;
  --danger: #e0638f;
  --warn: #d4923a;
  --shadow: rgba(63, 174, 142, 0.20);
}

.theme-purple {
  --bg: #f3eefe;
  --bg-grad: linear-gradient(160deg, #E9E3FF 0%, #E0F2FE 100%);
  --surface: #ffffff;
  --surface-2: #f5f0ff;
  --primary: #8b5cf6;
  --primary-soft: #ede9fe;
  --secondary-soft: #e3dbff;
  --text: #2c2540;
  --text-soft: #6b6390;
  --border: #e6defb;
  --danger: #e0638f;
  --warn: #c98b3a;
  --shadow: rgba(139, 92, 246, 0.18);
}

.theme-night {
  --bg: #15191a;
  --bg-grad: linear-gradient(160deg, #1b2127 0%, #13181c 100%);
  --surface: #1f2624;
  --surface-2: #232b29;
  --primary: #6fd3b5;
  --primary-soft: #243a33;
  --secondary-soft: #2a3a44;
  --text: #e6efeb;
  --text-soft: #9fb3ac;
  --border: #2c3633;
  --danger: #e88a7d;
  --warn: #e3b277;
  --shadow: rgba(0, 0, 0, 0.45);
}

.page {
  min-height: 100vh;
  background: var(--bg-grad);
  color: var(--text);
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 18rpx 24rpx;
  box-shadow: 0 6rpx 24rpx var(--shadow);
}

.row {
  display: flex;
  align-items: center;
}

.muted { color: var(--text-soft); }

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
  border: none;
}

.btn-ghost {
  background: var(--surface-2);
  color: var(--text-soft);
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  border: 1rpx solid var(--border);
}

.btn-danger {
  background: var(--danger);
  color: #fff;
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  border: none;
}

.divider { height: 1rpx; background: var(--border); margin: 20rpx 0; }

.pill {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--primary-soft);
  color: var(--primary);
  margin-right: 10rpx;
}

.pill.neg { background: rgba(224, 122, 107, 0.14); color: var(--danger); }
.pill.warn { background: rgba(224, 169, 107, 0.16); color: var(--warn); }

.empty {
  text-align: center;
  color: var(--text-soft);
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.8;
}

.title { font-size: 34rpx; font-weight: 600; }
.sub { font-size: 24rpx; color: var(--text-soft); margin-top: 8rpx; line-height: 1.6; }

input, textarea, picker { color: var(--text); }
